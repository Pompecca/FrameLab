<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Fondo" Color="#0F1218"/>
  <SolidColorBrush x:Key="Lateral" Color="#141821"/>
  <SolidColorBrush x:Key="Tarjeta" Color="#1A1F2B"/>
  <SolidColorBrush x:Key="TarjetaHover" Color="#232A38"/>
  <SolidColorBrush x:Key="Borde" Color="#2A3140"/>
  <SolidColorBrush x:Key="Tinta" Color="#EEF1F6"/>
  <SolidColorBrush x:Key="Suave" Color="#9AA5B8"/>
  <SolidColorBrush x:Key="Acento" Color="#22C7D6"/>
  <SolidColorBrush x:Key="AcentoHover" Color="#4DD8E4"/>

  <Style x:Key="BotonBase" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Tinta}"/>
    <Setter Property="Background" Value="{StaticResource TarjetaHover}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
    <Setter Property="Background" Value="{StaticResource Acento}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Acento}"/>
    <Setter Property="Foreground" Value="#06242A"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="Nav" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Suave}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="10,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="12,9">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1E2430"/><Setter Property="Foreground" Value="{StaticResource Tinta}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#17333C"/><Setter Property="Foreground" Value="{StaticResource AcentoHover}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Tinta}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="c" Width="20" Height="20" CornerRadius="5" BorderThickness="1.5" BorderBrush="#4A5468" Background="Transparent">
              <TextBlock x:Name="v" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#06242A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="c" Property="Background" Value="{StaticResource Acento}"/><Setter TargetName="c" Property="BorderBrush" Value="{StaticResource Acento}"/><Setter TargetName="v" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="c" Property="Opacity" Value="0.3"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb"><Border Background="#3A4354" CornerRadius="4" Margin="2"/></ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
